.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# raw pulls and generated warehouse artefacts stay out of version control
data/raw/
data/vintages/
data/*.duckdb
data/*.duckdb.wal
!data/sample/

# dbt. profiles.yml is committed on purpose: it holds a relative DuckDB path
# and no credentials, so the repo runs as cloned.
dbt/nyc311_warehouse/target/
dbt/nyc311_warehouse/dbt_packages/
dbt/nyc311_warehouse/logs/

# Generated reports are committed on purpose. They are the evidence for every
# number in the README and the memo, both of which link into them, and the BI
# mart is a stated deliverable rather than a build artefact. Around 11 MB in
# total, all of it regenerable by `make reports`.

# Output of the offline sample run. Regenerable by `make demo-sample`, and kept
# out of the repo so there is exactly one set of committed numbers.
reports/generated_sample/

# local dev scratch, not part of the deliverable
data/dev/
data/dev.duckdb
dbt/.user.yml
